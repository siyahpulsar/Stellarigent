# Discord Bot Token (get it from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Local Web Dashboard Port (default: 3000)
PORT=3000

# Discord Founder ID (User ID of the founder who can approve/reject bot actions)
FOUNDER_DISCORD_ID=

# Web Dashboard Founder key (used for authentication if setup)
FOUNDER_KEY=your_secret_password_here

