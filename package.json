{
  "name": "stellarigent",
  "version": "1.0.0",
  "description": "Stellarigent - Autonomous Local AI Agent framework connecting to LM Studio with strict user approvals and computer-use capabilities",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:ide": "electron electron/main.js",
    "test": "node evals/system_regression_suite.js && node evals/run_evals.js",
    "test:system": "node evals/system_regression_suite.js",
    "eval": "node evals/run_evals.js",
    "eval:trend": "node evals/trend_report.js",
    "eval:trend:last5": "node evals/trend_report.js --last 5"
  },
  "dependencies": {
    "@discordjs/voice": "^0.17.0",
    "axios": "^1.7.2",
    "cheerio": "^1.2.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "libsodium-wrappers": "^0.7.13",
    "monaco-editor": "^0.56.0",
    "opusscript": "^0.0.8",
    "pdf-parse": "^2.4.5",
    "prism-media": "^1.3.5",
    "puppeteer": "^25.2.1",
    "ws": "^8.16.0"
  },
  "private": true,
  "devDependencies": {
    "electron": "^43.2.0"
  }
}
